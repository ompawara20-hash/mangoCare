# MangoCare AI Configuration File
# Copy this file to .env and adjust variables as needed

APP_NAME="MangoCare AI - Mango Disease Detection & Health Assessment System"
APP_ENV="development"
APP_VERSION="1.0.0"

# Networking
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:5173"

# Upload and Security Constraints
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS="jpg,jpeg,png,webp"

# Local SQLite Storage
DATABASE_URL="sqlite:///./data/mangocare.db"

# Machine Learning Checkpoints
MODEL_DIRECTORY="./app/ml/weights"
MANGO_MODEL_ID="ixrbhii/mango-disease-convnext"
VALIDATOR_MODEL_NAME="mobilenet_v3_small"

# Decision Thresholds
CONFIDENCE_THRESHOLD=0.50
HIGH_CONFIDENCE_THRESHOLD=0.70
VALIDATION_THRESHOLD=0.60

# PDF Reports Storage
REPORT_DIRECTORY="./reports"

# Demo Mode (strictly for offline UI preview; disabled by default)
ALLOW_DEMO_MODE=false
